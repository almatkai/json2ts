[package]
name = "json2ts-beta-contract"
version = "0.1.0"
edition = "2021"
rust-version = "1.85"
license = "MIT AND Apache-2.0"
[dependencies]
tezbar-json2ts = { path = "../.." }
serde_json = "=1.0.145"
tokio = { version = "=1.48.0", features = ["rt-multi-thread", "macros", "sync", "time"] }
tempfile = "=3.23.0"
uuid = { version = "=1.18.1", features = ["v4"] }
log = "=0.4.28"
tauri = { path = "tauri-stub" }
json2ts-native-fixture = { path = "native-fixture" }
